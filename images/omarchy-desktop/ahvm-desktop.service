[Unit]
Description=Omarchy desktop session
Requires=user@1000.service seatd.service
After=user@1000.service seatd.service systemd-logind.service
[Service]
User=desktop
PAMName=login
WorkingDirectory=/home/desktop
Environment=HOME=/home/desktop XDG_RUNTIME_DIR=/run/user/1000 XDG_SESSION_TYPE=wayland XDG_SESSION_DESKTOP=Hyprland XDG_CURRENT_DESKTOP=Hyprland
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus AQ_NO_KMS_REQUIREMENT=1 LIBSEAT_BACKEND=seatd OMARCHY_PATH=/usr/share/omarchy
Environment=PATH=/usr/share/omarchy/bin:/usr/local/bin:/usr/bin
ExecStart=/usr/bin/start-hyprland -- --config /home/desktop/hyprland.lua
ExecStopPost=/usr/bin/systemctl --user stop ahvm-desktop-relay.service ahvm-vnc.service
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
